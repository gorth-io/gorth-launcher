# Exact issuer from Gorth's /.well-known/openid-configuration.
VITE_GORTH_SSO_ISSUER=
VITE_GORTH_SSO_CLIENT_ID=gorth-launcher
# Register this exact loopback URI for a public client with PKCE S256.
VITE_GORTH_SSO_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional existing Eclipse Temurin 17 installation; leave unset for auto discovery/download.
JAVA_HOME=

# Main-process only. Obtain your own key from the CurseForge developer console.
CURSEFORGE_API_KEY=

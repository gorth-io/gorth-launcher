{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "jsx": "preserve",
    "incremental": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": ".vite",
    "paths": {
      "@/*": ["./*"]
    },
    "plugins": [
      {
        "name": "electron"
      }
    ]
  },
  "include": [
    "forge-env.d.ts",
    "forge.config.ts",
    "vite.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mjs"
  ],
  "exclude": ["node_modules", ".vite", "out", "dist", "packages", "tests"]
}

{
  "name": "@gorth/launcher",
  "productName": "Gorth Launcher",
  "version": "0.0.0",
  "description": "Minecraft instance manager",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "pull": "ncu -u -x @eslint/js,eslint,typescript,pnpm --dep prod,dev,optional,peer,packageManager && pnpm i",
    "test:auth": "node scripts/test-auth.mjs",
    "test:game": "node scripts/test-game.mjs",
    "test:library": "node scripts/test-library.mjs",
    "test:content": "node scripts/test-content.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": {
    "name": "goraria",
    "email": "gorariagroup@gmail.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "better-sqlite3",
      "esbuild"
    ],
    "ignoredBuiltDependencies": []
  },
  "dependencies": {
